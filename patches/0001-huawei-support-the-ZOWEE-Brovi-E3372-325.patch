From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20H=C3=B6chst?= <hoechst@trackit.systems>
Date: Wed, 7 Oct 2026 16:58:56 +0200
Subject: [PATCH] huawei: support the ZOWEE (Brovi) E3372-325

The ZOWEE (sold as Brovi or Huawei) E3372-325 LTE stick (3566:2001) runs
Huawei-compatible firmware on a Marvell chipset. After switching it to
modem mode with the HuaweiAlt message (usb_modeswitch -X), it exposes two
AT ports (interfaces 1 and 4), a diagnostics port (interface 2) and an NCM
function (interfaces 5 and 6). The USB ID stays the same.

It answers the Huawei-specific commands the plugin uses (^SYSINFOEX,
^SYSCFGEX, ^HCSQ, ^RSSI, ...), but not ^GETPORTMODE. Its NCM port never
sends the link notification, so cdc_ncm never reports a carrier even after
^NDISDUP connects; data has to go over PPP on interface 1.

Accept the device in the Huawei plugin, set the port types explicitly,
skip ^GETPORTMODE and ignore the NCM port, so the plugin creates a PPP
bearer.
---
 src/plugins/huawei/77-mm-huawei-net-port-types.rules | 11 +++++++++++
 src/plugins/huawei/mm-plugin-huawei.c                |  6 ++++++
 2 files changed, 17 insertions(+)

diff --git a/src/plugins/huawei/77-mm-huawei-net-port-types.rules b/src/plugins/huawei/77-mm-huawei-net-port-types.rules
index fd53494..f9fef6b 100644
--- a/src/plugins/huawei/77-mm-huawei-net-port-types.rules
+++ b/src/plugins/huawei/77-mm-huawei-net-port-types.rules
@@ -1,6 +1,7 @@
 # do not edit this file, it will be overwritten on update
 ACTION!="add|change|move|bind", GOTO="mm_huawei_port_types_end"
 SUBSYSTEMS=="usb", ATTRS{idVendor}=="12d1", GOTO="mm_huawei_port_types"
+SUBSYSTEMS=="usb", ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", GOTO="mm_huawei_port_types"
 GOTO="mm_huawei_port_types_end"
 
 LABEL="mm_huawei_port_types"
@@ -34,4 +35,14 @@ ATTRS{idVendor}=="12d1", ATTRS{idProduct}=="1588", ENV{ID_MM_PREFERRED_NETWORKS_
 # E226, Disable CPOL based features
 ATTRS{idVendor}=="12d1", ATTRS{idProduct}=="1003", ENV{ID_MM_PREFERRED_NETWORKS_CPOL_DISABLED}="1"
 
+# ZOWEE (Brovi) E3372-325 in modem mode, Huawei-compatible firmware on a Marvell chipset:
+#  if1: AT + PPP, if2: diagnostics, if4: AT, if5/6: NCM.
+# ^GETPORTMODE is not supported, and the NCM port never reports a link, so data goes over PPP.
+SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"
+ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", ENV{ID_MM_HUAWEI_DISABLE_GETPORTMODE}="1"
+ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", ENV{.MM_USBIFNUM}=="01", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", ENV{.MM_USBIFNUM}=="02", SUBSYSTEM=="tty", ENV{ID_MM_PORT_IGNORE}="1"
+ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", ENV{.MM_USBIFNUM}=="04", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_SECONDARY}="1"
+ATTRS{idVendor}=="3566", ATTRS{idProduct}=="2001", ENV{.MM_USBIFNUM}=="05", SUBSYSTEM=="net", ENV{ID_MM_PORT_IGNORE}="1"
+
 LABEL="mm_huawei_port_types_end"
diff --git a/src/plugins/huawei/mm-plugin-huawei.c b/src/plugins/huawei/mm-plugin-huawei.c
index c59d0df..9885953 100644
--- a/src/plugins/huawei/mm-plugin-huawei.c
+++ b/src/plugins/huawei/mm-plugin-huawei.c
@@ -705,6 +705,11 @@ mm_plugin_create_huawei (void)
 {
     static const gchar *subsystems[] = { "tty", "net", "usbmisc", NULL };
     static const guint16 vendor_ids[] = { 0x12d1, 0 };
+    /* Huawei-compatible firmware on non-Huawei hardware */
+    static const mm_uint16_pair product_ids[] = {
+        { 0x3566, 0x2001 }, /* ZOWEE (Brovi) E3372-325 */
+        { 0, 0 }
+    };
     static const MMAsyncMethod custom_init = {
         .async  = G_CALLBACK (huawei_custom_init),
         .finish = G_CALLBACK (huawei_custom_init_finish),
@@ -715,6 +720,7 @@ mm_plugin_create_huawei (void)
                       MM_PLUGIN_NAME,               MM_MODULE_NAME,
                       MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
                       MM_PLUGIN_ALLOWED_VENDOR_IDS, vendor_ids,
+                      MM_PLUGIN_ALLOWED_PRODUCT_IDS, product_ids,
                       MM_PLUGIN_ALLOWED_AT,         TRUE,
                       MM_PLUGIN_REQUIRED_QCDM,      TRUE,
                       MM_PLUGIN_ALLOWED_QMI,        TRUE,
