# ModemManager the plugin is built against. The plugin uses daemon-internal
# symbols, so it must match the modemmanager package on the target system
# (Raspberry Pi OS trixie, arm64).
MM_REPO=https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git
MM_TAG=1.24.0
MM_COMMIT=dfa41adf391b090720fb1ea56d884f61ea7fba29

# Debian package version the build is verified against (checked at install time).
MM_DEBIAN_VERSION=1.24.0-1+deb13u1
